---
/**
 * List item for an entry in the logs collection: a dark terminal card for logs, or typewritten
 * paper (matching TypewriterPage) for dispatches. Both share the same layout and text sizes.
 */
import type { CollectionEntry } from 'astro:content';
import PaperClip from './PaperClip.astro';

type Props = {
  entry: CollectionEntry<'logs'>;
  href: string;
  headingLevel?: 'h2' | 'h3';
  showPinned?: boolean;
  showTags?: boolean;
};

const { entry, href, headingLevel: Heading = 'h3', showPinned, showTags } = Astro.props;
const { kind, title, summary, date } = entry.data;
const dateStr = date.toISOString().slice(0, 10);
const pinned = showPinned && entry.data.pinned;
const tags = showTags ? (entry.data.tags ?? []) : [];
---

{kind === 'dispatch' ? (
  // 21px padding = a log card's 20px padding + 1px border, so the text and height line up
  <li class="typewriter-paper dispatch-card p-[21px]">
    <PaperClip class="dispatch-card-clip" />

    <dl class="dispatch-card-meta grid gap-1 text-[10px] uppercase tracking-[0.14em] sm:grid-cols-2">
      <div class="flex gap-2">
        <dt class="opacity-70">Type</dt>
        <dd>Dispatch</dd>
      </div>
      <div class="flex gap-2 sm:justify-end">
        <dt class="opacity-70">Date</dt>
        <dd>{dateStr}</dd>
      </div>
      {pinned ? (
        <div class="flex gap-2">
          <dt class="opacity-70">Status</dt>
          <dd>Pinned</dd>
        </div>
      ) : null}
    </dl>

    <a href={href} class="dispatch-card-link mt-4 block">
      <Heading class="dispatch-card-title text-base leading-snug">{title}</Heading>
    </a>

    {summary ? <p class="mt-3 text-sm leading-snug">{summary}</p> : null}

    {tags.length ? (
      <ul class="dispatch-card-tags mt-3 flex flex-wrap text-[11px] uppercase tracking-[0.1em]" aria-label="Tags">
        {tags.map((t) => <li>{t}</li>)}
      </ul>
    ) : null}

    <div class="typewriter-stamp dispatch-card-stamp" aria-hidden="true">
      <span>Off the record</span>
      <small>From the desk of S.C. Barrus</small>
    </div>
  </li>
) : (
  <li class="log-card rounded-sm border border-refuge-border bg-refuge-surface p-5 shadow-panel">
    <dl class="grid gap-1 font-mono text-[10px] uppercase tracking-[0.14em] text-refuge-muted sm:grid-cols-2">
      <div class="flex gap-2">
        <dt class="text-refuge-muted/80">Type</dt>
        <dd class="text-refuge-fg/90">{kind}</dd>
        {pinned ? <dd class="text-refuge-terminal">Pinned</dd> : null}
      </div>
      <div class="flex gap-2 sm:justify-end">
        <dt class="text-refuge-muted/80">Date</dt>
        <dd class="text-refuge-terminal">{dateStr}</dd>
      </div>
    </dl>

    <a href={href} class="log-card-link mt-4 block">
      <Heading class="log-card-title font-mono text-base font-semibold leading-snug text-refuge-fg">
        {title}
      </Heading>
    </a>

    {summary ? <p class="mt-3 font-serif text-sm leading-snug text-refuge-fg/90">{summary}</p> : null}

    {tags.length ? (
      <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
        {tags.map((t) => (
          <li class="rounded-sm border border-refuge-border bg-refuge-surface px-2 py-1 font-mono text-[11px] text-refuge-muted">
            {t}
          </li>
        ))}
      </ul>
    ) : null}
  </li>
)}

<style>
  /*
   * The title link's ::after stretches over the whole card, making it the click target.
   * Any interactive element added to a card needs position: relative; z-index: 1 to sit above it.
   */
  .log-card,
  .dispatch-card {
    position: relative;
    cursor: pointer;
  }
  .log-card-link::after,
  .dispatch-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .log-card-link:focus-visible,
  .dispatch-card-link:focus-visible {
    outline: none;
  }
  .log-card-link:focus-visible::after {
    outline: 2px solid var(--color-refuge-terminal);
    outline-offset: 2px;
  }
  /* Inset, because an ink outline outside the paper would vanish on the black page */
  .dispatch-card-link:focus-visible::after {
    outline: 2px solid var(--ink);
    outline-offset: -5px;
  }

  .log-card {
    transition: border-color 150ms ease;
  }
  .log-card:has(.log-card-link:focus-visible) {
    border-color: var(--color-refuge-terminal);
  }
  .log-card-link:focus-visible .log-card-title {
    color: var(--color-refuge-terminal);
  }

  .dispatch-card {
    margin-block: 0.75rem;
    /* Lifted bottom-right corner */
    --paper-extra-layer: linear-gradient(135deg, transparent 75%, rgba(80, 55, 20, 0.1) 100%);
    /* A dark shadow vanishes on the black page, so depth comes from light and edge detail */
    box-shadow:
      0 0 60px 6px rgba(255, 225, 170, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 0 0 1px rgba(60, 40, 15, 0.12),
      inset 0 -3px 6px rgba(60, 40, 15, 0.12);
    transform: rotate(-0.3deg);
    transition:
      transform 150ms ease,
      box-shadow 150ms ease;
    font-family: 'Courier Prime', 'Courier New', Courier, monospace;
    text-shadow: 0 0 0.7px rgba(31, 27, 22, 0.55);
  }
  .dispatch-card:has(.dispatch-card-link:focus-visible) {
    box-shadow:
      0 0 70px 10px rgba(255, 225, 170, 0.13),
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 0 0 1px rgba(60, 40, 15, 0.12),
      inset 0 -3px 6px rgba(60, 40, 15, 0.12);
    transform: translateY(-2px) rotate(-0.3deg);
  }

  /* Touch screens would otherwise leave these stuck on after a tap */
  @media (hover: hover) {
    .log-card:hover {
      border-color: var(--color-refuge-terminal);
    }
    .log-card:hover .log-card-title {
      color: var(--color-refuge-terminal);
    }
    .dispatch-card:hover {
      box-shadow:
        0 0 70px 10px rgba(255, 225, 170, 0.13),
        inset 0 1px 0 rgba(255, 255, 255, 0.5),
        inset 0 0 0 1px rgba(60, 40, 15, 0.12),
        inset 0 -3px 6px rgba(60, 40, 15, 0.12);
      transform: translateY(-2px) rotate(-0.3deg);
    }
    .dispatch-card:hover .dispatch-card-title {
      text-decoration-thickness: 3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .log-card,
    .dispatch-card {
      transition: none;
    }
    .dispatch-card:has(.dispatch-card-link:focus-visible),
    .dispatch-card:hover {
      transform: rotate(-0.3deg);
    }
  }

  .dispatch-card-clip {
    position: absolute;
    top: -22px;
    left: 0.75rem;
    width: 16px;
    height: 44px;
    transform: rotate(4deg);
    filter: drop-shadow(1px 2px 1px rgba(0, 0, 0, 0.35));
    pointer-events: none;
  }

  /* Out of the layout flow, so the stamp can land across the text */
  .dispatch-card-stamp {
    position: absolute;
    top: 38px;
    /* 20px clear of the date's left edge; the date's width is fixed by its YYYY-MM-DD format */
    right: 154px;
    padding: 0.25rem 0.6rem 0.3rem;
    transform: rotate(7deg);
    text-shadow: none;
    /* Sits above the stretched link, so clicks need to pass through to it */
    pointer-events: none;
  }
  .dispatch-card-stamp span {
    font-size: 0.95rem;
  }
  .dispatch-card-stamp small {
    font-size: 0.45rem;
    margin-top: 0.1rem;
  }

  .dispatch-card-meta,
  .dispatch-card-tags {
    font-family: 'Special Elite', 'Courier New', monospace;
  }

  /* Tags are typed on one line, separated by slashes */
  .dispatch-card-tags li + li::before {
    content: '/';
    margin-inline: 0.5em;
  }

  .dispatch-card-title {
    font-family: 'Special Elite', 'Courier New', monospace;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }


  .dispatch-card ::selection {
    background: rgba(31, 27, 22, 0.2);
    color: var(--ink);
  }

  /* Type and date stack on small screens, which leaves the top right corner free */
  @media (max-width: 639px) {
    .dispatch-card-stamp {
      top: 18px;
      right: 0.75rem;
    }
  }
  /* The narrowest phones need a smaller stamp to clear the date */
  @media (max-width: 359px) {
    .dispatch-card-stamp {
      right: 0.5rem;
    }
    .dispatch-card-stamp span {
      font-size: 0.78rem;
    }
    .dispatch-card-stamp small {
      font-size: 0.37rem;
    }
  }
</style>
