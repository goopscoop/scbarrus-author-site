---
import ConnectionReadout from './ConnectionReadout.astro';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer id="site-footer" class="relative z-10 mt-16 border-t border-refuge-border bg-refuge-surface">
  <div
    class="mx-auto flex max-w-content flex-col gap-4 px-4 py-8 text-sm text-refuge-muted sm:px-5 sm:py-8"
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div class="flex flex-col gap-3">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-refuge-muted">
          © {year} · THE REFUGE
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-refuge-muted/80">Known transmission channels:</p>
          <SocialLinks />
        </div>
      </div>
      <ConnectionReadout align="end" variant="footer" />
    </div>
  </div>
</footer>
