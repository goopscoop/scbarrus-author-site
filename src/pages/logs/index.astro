---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LogCard from '../../components/LogCard.astro';
import { getCollection } from 'astro:content';

function logSlugFromId(id: string): string {
  return (id.split('/').pop() ?? id).replace(/\.mdx?$/i, '');
}

const entries = (
  await getCollection('logs', ({ data, id }) => {
    if (data.draft) return false;
    if (logSlugFromId(id).toLowerCase().startsWith('example')) return false;
    return true;
  })
).sort((a, b) => {
  const ap = a.data.pinned ? 1 : 0;
  const bp = b.data.pinned ? 1 : 0;
  if (ap !== bp) return bp - ap;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<BaseLayout
  title="The Refuge Logs"
  description="In-world documents, surveillance records and excerpts from KULT, a dystopian novel in progress by S.C. Barrus — intercepted from the Municipal Archive of Refuge."
>
  <div class="mx-auto max-w-content px-4 py-12 sm:px-5">
    <header class="max-w-measure">
      <h1 class="font-mono text-2xl font-semibold tracking-tight sm:text-3xl">The Refuge Logs</h1>
      <p class="mt-3 font-serif text-lg leading-snug text-refuge-fg/95">
        Welcome to the Refuge Logs. This data has been intercepted from the Municipal Authority and displayed here in real time.
      </p>
      <p class="mt-3 font-serif text-lg leading-snug text-refuge-fg/95">
        Primary documents include the ravings and drawings of one S.C. Barrus, a citizen of Refuge. Some items may be unfit for public consumption. READ AT YOUR OWN RISK.
      </p>
    </header>

    <ol class="mt-12 grid gap-4">
      {
        entries.map((entry) => (
          <LogCard
            entry={entry}
            href={`/logs/${logSlugFromId(entry.id)}/`}
            headingLevel="h2"
            showPinned
            showTags
          />
        ))
      }
    </ol>
  </div>
</BaseLayout>
