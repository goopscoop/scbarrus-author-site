---
import LogTerminal from '../../components/mdx/LogTerminal.astro';
import TypewriterPage from '../../components/TypewriterPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('logs', ({ data }) => !data.draft);
  // Dispatches are numbered in publish order (No. 01, No. 02 ...).
  const dispatches = entries
    .filter((e) => e.data.kind === 'dispatch')
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return entries.map((entry) => {
    const tail = entry.id.split('/').pop() ?? entry.id;
    const slug = tail.replace(/\.mdx?$/i, '');
    const dispatchNumber = entry.data.kind === 'dispatch' ? dispatches.indexOf(entry) + 1 : undefined;
    return { params: { slug }, props: { entry, dispatchNumber } };
  });
}

const { entry, dispatchNumber } = Astro.props;
const isDispatch = entry.data.kind === 'dispatch';
const { Content } = await render(entry);
const description = entry.data.description ?? entry.data.summary ?? entry.data.title;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description,
  datePublished: entry.data.date.toISOString().slice(0, 10),
  author: { '@id': 'https://scbarrus.com/#person' },
  isPartOf: { '@id': `${Astro.site}#website` },
  ...(entry.data.image ? { image: new URL(entry.data.image, Astro.site).href } : {}),
};
---

<BaseLayout
  title={entry.data.title}
  seoTitle={entry.data.seoTitle}
  description={description}
  ogType="article"
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  jsonLd={[articleLd]}
>
  {isDispatch ? (
    <div class="mx-auto max-w-content px-4 py-12 sm:px-5">
      <TypewriterPage title={entry.data.title} date={entry.data.date} number={dispatchNumber}>
        <Content components={{ LogTerminal }} />
      </TypewriterPage>
      <div class="mt-16">
        <NewsletterSignup client:visible />
      </div>
      <nav class="mt-12 border-t border-refuge-border pt-8" aria-label="Log navigation">
        <a class="font-mono text-sm font-medium text-refuge-terminal hover:underline" href="/logs/">
          ← Return to logs index
        </a>
      </nav>
    </div>
  ) : (
  <article class="mx-auto max-w-content px-4 py-12 sm:px-5">
    <header class="border-b border-refuge-border pb-8">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-refuge-muted">Refuge log</p>
      <h1 class="mt-3 font-mono text-3xl font-semibold tracking-tight sm:text-4xl">{entry.data.title}</h1>
      <p class="mt-4 font-mono text-sm text-refuge-muted">{entry.data.date.toISOString().slice(0, 10)}</p>
      {entry.data.tags?.length ? (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
          {entry.data.tags.map((t: string) => (
            <li class="rounded-sm border border-refuge-border bg-refuge-surface px-2 py-1 font-mono text-[11px] text-refuge-muted">
              {t}
            </li>
          ))}
        </ul>
      ) : null}
    </header>

    {entry.data.image ? (
      <figure class="mt-10">
        <img
          src={entry.data.image}
          alt={entry.data.imageAlt ?? ''}
          loading="lazy"
          decoding="async"
          class="w-full rounded-sm border border-refuge-border bg-refuge-surface"
        />
        {entry.data.imageAlt ? (
          <figcaption class="mt-3 font-serif text-sm leading-snug text-refuge-muted">{entry.data.imageAlt}</figcaption>
        ) : null}
      </figure>
    ) : null}

    <div
      class:list={[
        'prose prose-invert max-w-none prose-headings:font-mono prose-headings:tracking-tight prose-p:font-serif prose-p:text-base prose-p:leading-snug prose-li:font-serif prose-li:leading-snug prose-a:text-refuge-terminal prose-a:no-underline hover:prose-a:underline',
        entry.data.image ? 'mt-10' : 'mt-10',
      ]}
    >
      <Content components={{ LogTerminal }} />
    </div>
    <br/>
    <NewsletterSignup client:visible />
    <nav class="mt-12 border-t border-refuge-border pt-8" aria-label="Log navigation">
      <a
        class="font-mono text-sm font-medium text-refuge-terminal hover:underline"
        href="/logs/"
      >
        ← Return to logs index
      </a>
    </nav>
  </article>
  )}
</BaseLayout>
